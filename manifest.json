{
  "manifest_version": 3,
  "name": "AppPort Web Monitor",
  "description": "Monitor a webpage with AppPort-backed schedules, jobs, and notifications.",
  "version": "1.0.0",
  "permissions": ["activeTab", "alarms", "notifications", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' data: http: https:"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "AppPort Monitor",
    "default_popup": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
